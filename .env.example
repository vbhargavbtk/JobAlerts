# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Personal Government Job Notification Intelligence & Eligibility Alert System
# ==============================================================================
# Copy this file to .env and supply your credentials.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0
ADMIN_SECRET_KEY=change_this_to_a_secure_random_key_for_admin_api

# ------------------------------------------------------------------------------
# COMPONENT A: TELEGRAM MTPROTO LISTENER (User Account Credentials)
# Obtain API ID & HASH from: https://my.telegram.org/apps
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=30164186
TELEGRAM_API_HASH=a84cc93f679fbfdc9849deb2261160ee
# Generate this string once using: python scripts/generate_session.py
TELEGRAM_SESSION=your_telethon_string_session_base64_here

# ------------------------------------------------------------------------------
# COMPONENT H: TELEGRAM BOT (Outgoing Alerts & Profile Management)
# Create a bot via @BotFather on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Your personal Telegram user/chat ID (retrieve via @userinfobot)
TELEGRAM_ALERT_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Persistent PostgreSQL)
# Suitable for Neon, Supabase, Render PostgreSQL, or local Postgres
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_alerts
# For local lightweight testing fallback (SQLite async)
# DATABASE_URL=sqlite+aiosqlite:///./job_alerts.db

# ------------------------------------------------------------------------------
# COMPONENT B: N8N ORCHESTRATOR
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/job-event
N8N_API_KEY=your_n8n_api_key_if_configured

# ------------------------------------------------------------------------------
# COMPONENT D: AI PROVIDERS (Configured in Priority Order: NIM -> Gemini -> OpenRouter)
# ------------------------------------------------------------------------------
# 1. NVIDIA NIM (Primary) - https://build.nvidia.com
NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# 2. Google Gemini (Secondary Fallback) - https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter (Tertiary Fallback) - https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# CONTENT ACQUISITION & SEARCH FALLBACK
# ------------------------------------------------------------------------------
# Optional: Tavily API for Level 3 search fallback (1000 free searches/month)
# If not set, duckduckgo_search is used automatically.
TAVILY_API_KEY=

# Maximum PDF download size in MB (default 25MB)
MAX_PDF_SIZE_MB=25
HTTP_TIMEOUT_SECONDS=25
